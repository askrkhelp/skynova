# Gemini API key (required). Get one from Google AI Studio.
# Loaded from the environment only — never hardcode this.
GEMINI_API_KEY=

# Case store backend: "local" (default, reads/writes data/cases.json)
# or "firestore" (Cloud Run / prod). See CaseStore in app/store.
CASE_STORE_BACKEND=local

# GCP project id — required only when CASE_STORE_BACKEND=firestore.
GOOGLE_CLOUD_PROJECT=

# Port the Gradio app listens on. Cloud Run injects this automatically;
# set locally only if 8080 is taken.
PORT=8080
